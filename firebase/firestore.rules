rules_version = '2';

// SecureCampus Firestore rules.
//
// Role source of truth: users/{uid}.role, one of
// "admin" | "student" | "security" | "librarian" | "driver", plus
// users/{uid}.active (bool). The Admin portal is the only place that
// creates/deactivates accounts; the iris_ai service and Admin SDK
// scripts write to sensitive collections with the Admin SDK, which
// bypasses these rules entirely - these rules exist to stop a
// compromised or malicious *client* from reading/writing data outside
// its role, per project spec section 39 ("Never rely only on Flutter
// UI to protect data").
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn()
        && currentUser().role == role
        && currentUser().active == true;
    }

    function isAdmin()     { return hasRole('admin'); }
    function isStudent()   { return hasRole('student'); }
    function isSecurity()  { return hasRole('security'); }
    function isLibrarian() { return hasRole('librarian'); }
    function isDriver()    { return hasRole('driver'); }

    // Map coordinates must be real numbers on the globe, so a typo cannot
    // save a campus or stop that is off the map.
    function validLat(v) { return v is number && v >= -90 && v <= 90; }
    function validLng(v) { return v is number && v >= -180 && v <= 180; }

    // ---------------------------------------------------------------
    // users - each user reads their own account doc; only Admin can
    // list/write any user (account creation, deactivation, role mgmt).
    // Users write their own fcmToken (and only that field) so push
    // notifications can actually be delivered - real bug fixed here:
    // push_notification_service.dart's _saveToken() was always being
    // rejected before this, so no FCM token was ever persisted for any
    // user, meaning no push notification could ever actually be sent -
    // only the in-app Alerts tab (a separate collection) worked.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      // A user may change only their own fcmToken, or clear their own
      // mustResetPassword flag (set it to false, never true) after choosing a
      // new password. Nothing else - in particular not role or active.
      allow update: if isAdmin()
                    || (request.auth.uid == uid
                        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken'])
                            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustResetPassword'])
                                && request.resource.data.mustResetPassword == false)));
      allow create, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // registrationNumbers - uniqueness-reservation docs, doc ID = the
    // registration number itself (fixed after audit - see
    // docs/AUDIT_REPORT.md "Security Issues" #4). Written only by the
    // Admin SDK inside a transaction (see iris_ai/app/firebase_client.py
    // ::_reserve_registration_number) - no client of any role needs to
    // touch this directly.
    // ---------------------------------------------------------------
    match /registrationNumbers/{regNo} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // students - a student may read (never write) their own record.
    // Admin manages all fields.
    // Librarian can read (real bug fixed here - findStudentByRegistrationNumber()
    // in librarian_repository.dart queries this collection to look up who's
    // borrowing a book; without this, every single library-desk search
    // silently found nobody, no matter how correct the registration number
    // typed in was, because the query itself was permission-denied).
    // ---------------------------------------------------------------
    match /students/{studentId} {
      allow read: if isAdmin() || isLibrarian() || (isStudent() && request.auth.uid == studentId);
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // courses - readable by any signed-in role that needs it
    // (a student for their own course list, admin for management).
    // ---------------------------------------------------------------
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // enrollments (student <-> course) - a student may read only their
    // own enrollment records.
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // lostCardReports - anyone signed in (including an anonymous-auth
    // "finder" session) may submit a report, but only as a new OPEN one with
    // a name and registration number. Admin reads, notifies the student and
    // resolves (only Admin may update or delete). Security may read, so they
    // see the report and then see it marked Resolved - they cannot change it.
    // ---------------------------------------------------------------
    match /lostCardReports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.finderUid == request.auth.uid
                    && request.resource.data.hasPhoto is bool
                    && request.resource.data.status == 'OPEN'
                    && request.resource.data.notified == false
                    && request.resource.data.studentName is string
                    && request.resource.data.studentName.size() > 1
                    && request.resource.data.registrationNumber is string
                    && request.resource.data.registrationNumber.size() > 2;
      allow read: if isAdmin() || isSecurity();
      allow update, delete: if isAdmin();
    }

    // lostCardPhotos - the optional photo of a found card, kept apart from the
    // report so Security (who may read reports) can never download it. Only the
    // finder can add it, once, in the same write as their own report that says
    // hasPhoto, and it must be small (a base64 string, stored in Firestore so no
    // paid Storage plan is needed). Only Admin reads or deletes it; it is
    // deleted when the report is resolved or deleted.
    match /lostCardPhotos/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['data', 'createdAt'])
                    && request.resource.data.data is string
                    && request.resource.data.data.size() > 0
                    && request.resource.data.data.size() <= 800000
                    && getAfter(/databases/$(database)/documents/lostCardReports/$(reportId)).data.finderUid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/lostCardReports/$(reportId)).data.hasPhoto == true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------------------------------------------------------------
    // library
    // ---------------------------------------------------------------
    match /books/{bookId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isLibrarian();
    }

    // Lock history: who locked or unlocked a book, in which role, when and why.
    // Append-only (never edited or deleted) so it is a trustworthy record.
    match /books/{bookId}/lockHistory/{eventId} {
      allow read: if isAdmin() || isLibrarian();
      allow create: if (isAdmin() || isLibrarian())
                    && request.resource.data.keys().hasOnly(['action', 'reason', 'byUid', 'byName', 'byRole', 'at'])
                    && request.resource.data.action in ['LOCK', 'UNLOCK']
                    && request.resource.data.byUid == request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() > 0
                    && request.resource.data.reason.size() <= 200;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // issueReports - a student reports a book they say they never
    // borrowed (proposal 4.2). The student may create one only for a loan
    // that really belongs to them; Librarian/Security/Admin read all and
    // may change only `status`. The overdue_checker service (Admin SDK)
    // sends the notifications.
    // ---------------------------------------------------------------
    match /issueReports/{reportId} {
      allow create: if isStudent()
                    && request.resource.data.keys().hasOnly(['issueId', 'bookId', 'bookTitle', 'studentId',
                         'studentName', 'registrationNumber', 'note', 'status', 'createdAt'])
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.status == 'NEW'
                    && request.resource.data.note.size() <= 200
                    && get(/databases/$(database)/documents/libraryIssues/$(request.resource.data.issueId)).data.studentId == request.auth.uid;
      allow read: if isAdmin() || isLibrarian() || isSecurity()
                  || (isStudent() && resource.data.studentId == request.auth.uid);
      allow update: if (isAdmin() || isLibrarian() || isSecurity())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    match /libraryIssues/{issueId} {
      allow read: if isAdmin() || isLibrarian() || (isStudent() && resource.data.studentId == request.auth.uid);
      // A locked book (kept in the safe) can never be issued, even by a
      // modified client; the app also checks this inside a transaction.
      allow create: if (isAdmin() || isLibrarian())
                    && get(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data.get('locked', false) != true;
      allow update, delete: if isAdmin() || isLibrarian();
    }

    // ---------------------------------------------------------------
    // bus / busStops / busAssignments - a student may read their own
    // assignment and general stop/bus metadata, never another
    // student's assignment. Live GPS itself lives in Realtime Database,
    // not here (see database.rules.json) and is NOT student-readable.
    // ---------------------------------------------------------------
    match /bus/{busId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // The campus location (the trip destination / start) lives in
    // config/transport as campusName, campusLat, campusLng. Everyone signed in
    // reads it; only Admin writes it, and only with a name and real coordinates.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
                   && (docId != 'transport'
                       || (request.resource.data.campusName is string
                           && request.resource.data.campusName.size() > 0
                           && request.resource.data.campusName.size() <= 120
                           && validLat(request.resource.data.campusLat)
                           && validLng(request.resource.data.campusLng)));
    }

    // Bus stops (name, lat, lng, order along the route). Everyone signed in
    // reads them; only Admin adds, moves or removes one, and a stop must have
    // a name, real coordinates and a route order.
    match /busStops/{stopId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin()
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 120
                            && validLat(request.resource.data.lat)
                            && validLng(request.resource.data.lng)
                            && request.resource.data.order is number;
      allow delete: if isAdmin();
    }

    match /busAssignments/{assignmentId} {
      allow read: if isAdmin() || isDriver() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // notifications - a user reads only notifications addressed to
    // them. Writes come from the Admin SDK (server-side services).
    // Marking a notification as read is the one client-side write
    // allowed, and only to the isRead field of one's own notification.
    // ---------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAdmin() || resource.data.recipient == request.auth.uid;
      allow update: if resource.data.recipient == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      // A user may delete their own notification (real feature added here:
      // "clear"/dismiss a notification, and "Clear all") - previously only
      // Admin could delete at all, so this action had no path to work.
      allow delete: if isAdmin() || resource.data.recipient == request.auth.uid;
      allow create: if isAdmin();
    }
  }
}