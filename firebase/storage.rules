rules_version = '2';

// Storage layout:
//   security_alerts/{cameraId}/{timestamp}.jpg  - unknown-person captures,
//                                                   written by the iris_ai
//                                                   service (Admin SDK).
//   qr_codes/{bookId}.png                        - generated by
//                                                   scripts/generate_qr_codes.py,
//                                                   uploaded by Admin.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    match /security_alerts/{cameraId}/{fileName} {
      // Written server-side only (Admin SDK bypasses these rules).
      // Objects are NOT made public (fixed post-audit - see
      // docs/AUDIT_REPORT.md "Security Issues" #1): this rule is what
      // actually gates access now. The Flutter client obtains a viewing
      // URL via FirebaseStorage.instance.ref(imagePath).getDownloadURL(),
      // which is itself subject to this "allow read" check - an
      // unauthorized caller's SDK call fails here before any URL exists.
      allow read: if isSignedIn() && (currentRole() == 'admin' || currentRole() == 'security');
      allow write: if false;
    }

    match /qr_codes/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && currentRole() == 'admin';
    }
  }
}
