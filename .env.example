# Copy this file to .env and fill in real values. Never commit the
# real .env (it's already in .gitignore).

# ---------------------------------------------------------------------
# Firebase
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=
# Path to your downloaded service-account JSON (Project settings ->
# Service accounts -> Generate new private key). Keep this file OUT of
# version control.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json
# Shown in Firebase console > Build > Storage (e.g. your-project-id.firebasestorage.app).
# Storage must be enabled ("Get started") for unknown-person photos to be saved.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Realtime Database URL, e.g. https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# ---------------------------------------------------------------------
# Bus ETA job (bus_eta/)
# ---------------------------------------------------------------------
BUS_ID=BUS-001
POLL_INTERVAL_SECONDS=20
# One in-app alert per trip, at this many minutes from the student's stop ("head to your stop")
ALERT_THRESHOLD_MINUTES=10
AVG_BUS_SPEED_KMH=25
# How the distance to a student's stop is measured. ETA = distance / AVG_BUS_SPEED_KMH.
#   osrm     = real road distance from OpenStreetMap routing (free, no key). Default.
#   straight = straight-line distance only.
# The public OSRM server is for light use (fine for a demo); host your own for production.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
# Optional: Google Distance Matrix API key (paid). If set it takes priority over
# ROUTING_PROVIDER and gives a road ETA with live traffic.
MAP_API_KEY=

# ---------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------
API_PORT=8000

# ---------------------------------------------------------------------
# Overdue / due-soon book checker (overdue_checker/)
# ---------------------------------------------------------------------
OVERDUE_CHECK_INTERVAL_SECONDS=60
# Send a "due soon" library notice when the return date is within this many hours
DUE_SOON_HOURS=48
