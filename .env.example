# Copy this file to .env and fill in real values. Never commit the
# real .env (it's already in .gitignore).

# ---------------------------------------------------------------------
# Firebase
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=
# Path to your downloaded service-account JSON (Project settings ->
# Service accounts -> Generate new private key). Keep this file OUT of
# version control.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# Realtime Database URL, e.g. https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# ---------------------------------------------------------------------
# Camera (iPhone 13 via RTSP & RTMP Cam - OctoStream)
# See docs/ or README "iPhone 13 RTSP setup" for exact steps.
# Never hardcode this - it changes with your local network/IP.
# ---------------------------------------------------------------------
CAMERA_RTSP_URL=rtsp://<iphone-local-ip>:<port>/live
CAMERA_NAME=GATE-CAM
CAMERA_LOCATION=Main Gate

# ---------------------------------------------------------------------
# Iris recognition
# ---------------------------------------------------------------------
# Not experimentally validated against real students yet - see
# docs/IRIS_MODEL.md section 6 before trusting this value for a demo.
IRIS_MATCH_THRESHOLD=0.32
# Reserved for a future deep-embedding model; unused by the current
# classical pipeline.
IRIS_MODEL_PATH=

# ---------------------------------------------------------------------
# Event handling
# ---------------------------------------------------------------------
UNKNOWN_ALERT_COOLDOWN_SECONDS=120
ATTENDANCE_DEDUPE_MINUTES=30
RECOGNITION_INTERVAL_SECONDS=2.0

# ---------------------------------------------------------------------
# Bus ETA job (bus_eta/)
# ---------------------------------------------------------------------
BUS_ID=BUS-001
POLL_INTERVAL_SECONDS=20
ALERT_THRESHOLD_MINUTES=10
AVG_BUS_SPEED_KMH=25
# Optional: Google Distance Matrix API key for real routing-based ETA
# instead of the straight-line/haversine fallback estimate.
MAP_API_KEY=

# ---------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------
API_PORT=8000
